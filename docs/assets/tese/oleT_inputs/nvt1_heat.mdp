; =====================================================================
; NVT 1/2 - AQUECIMENTO GRADUAL 50 -> 298.15 K via simulated annealing
;
; Rampa linear de 400 ps (~0.62 K/ps) + 100 ps de patamar.
; ESTE E O UNICO ARQUIVO QUE GERA VELOCIDADES: as replicas divergem aqui.
; Ajustar gen-seed/ld-seed por replica.
; =====================================================================

define                  = -DPOSRES -DPOSRES_FC_BB=2092.0 -DPOSRES_FC_SC=2092.0 -DPOSRES_FC_LIG=2092.0

; CONTROLE DA CORRIDA
integrator              = md
tinit                   = 0
dt                      = 0.001     ; 1 fs durante o aquecimento
nsteps                  = 500000    ; 500 ps

; SAIDA
nstxout			= 0	    ; salva coordenadas em trr
nstvout                 = 0         ; salva velocidades em trr
nstfout			= 0	    ; salva forcas em trr
nstenergy               = 1000      ; salva energias em edr
nstxout-compressed      = 1000      ; salva coordenadas em xtc
nstlog                  = 1000      ; update log
compressed-x-grps       = System

; NEIGHBORSEARCHING
cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
rlist                   = 1.0       ; Cut-off for making neighbor list 

; ELETROSTATICA
coulombtype             = PME
rcoulomb                = 1.0       ; short-range electrostatic cutoff (in nm)
pme-order               = 4
fourierspacing          = 0.12

; VDW
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
rvdw                    = 1.0       ; short-range van der Waals cutoff (in nm)
DispCorr                = EnerPres

; MOVIMENTO DO CENTRO DE MASSA
comm-mode               = Linear
nstcomm                 = 100

; ACOPLAMENTO DE TEMPERATURA
tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 0.5         ; time constant, in ps
ref-t                   = 298.15      ; temperatura de ref.

; RAMPA DE TEMPERATURA (interpolacao linear entre os pontos)
annealing               = single
annealing-npoints       = 2
annealing-time          = 0    400    ; in ps
annealing-temp          = 50   298.15

; PRESSAO
pcoupl                  = no

; GERACAO DE VELOCIDADES
gen-vel                 = yes
gen-temp                = 50        ; DEVE coincidir com annealing-temp inicial
gen-seed                = 777101
ld-seed                 = 777102
continuation            = no

; LIGACOES
constraint-algorithm    = lincs
constraints             = h-bonds
lincs-iter              = 1
lincs-order             = 4
