; =====================================================================
; NPT 3/4 - so cadeia principal restringida; cadeias laterais livres (500 ps)
; =====================================================================

define                  = -DPOSRES -DPOSRES_FC_BB=209.2 -DPOSRES_FC_SC=0.0 -DPOSRES_FC_LIG=0.0

integrator              = md
dt                      = 0.002
nsteps                  = 250000

; SAIDA
nstxout			= 0	    ; salva coordenadas em trr
nstvout                 = 0         ; salva velocidades em trr
nstfout			= 0	    ; salva forcas em trr
nstenergy               = 500       ; salva energias em edr
nstxout-compressed      = 500       ; salva coordenadas em xtc
nstlog                  = 500       ; update log
compressed-x-grps       = System

; NEIGHBORSEARCHING
cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
rlist                   = 1.0       ; Cut-off for making neighbor list 

; ELETROSTATICA
coulombtype             = PME
rcoulomb                = 1.0       ; short-range electrostatic cutoff (in nm)
pme-order               = 4
fourierspacing          = 0.12

; VDW
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
rvdw                    = 1.0       ; short-range van der Waals cutoff (in nm)
DispCorr                = EnerPres

; MOVIMENTO DO CENTRO DE MASSA
comm-mode               = Linear
nstcomm                 = 100

; ACOPLAMENTO DE TEMPERATURA
tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 1.0         ; time constant, in ps
ref-t                   = 298.15      ; temperatura de ref, em K

; ACOPLAMENTO DE PRESSAO
pcoupl                  = C-rescale
pcoupltype              = isotropic       ; uniform scaling of box vectors
tau-p                   = 2.0             ; time constant, in ps
ref-p                   = 1.0             ; pressao de ref, em bar
compressibility         = 4.5e-5
refcoord-scaling        = com

gen-vel                 = no
ld-seed                 = 777106
continuation            = yes

; LIGACOES
constraint-algorithm    = lincs
constraints             = h-bonds
lincs-iter              = 1
lincs-order             = 4
