; =====================================================================
; NVT 2/2 - patamar a 298.15 K antes de ligar o barostato
; =====================================================================

define                  = -DPOSRES -DPOSRES_FC_BB=836.8 -DPOSRES_FC_SC=836.8 -DPOSRES_FC_LIG=836.8

integrator              = md
dt                      = 0.002
nsteps                  = 100000    ; 200 ps

; SAIDA
nstxout			= 0	    ; salva coordenadas em trr
nstvout                 = 0         ; salva velocidades em trr
nstfout			= 0	    ; salva forcas em trr
nstenergy               = 500       ; salva energias em edr
nstxout-compressed      = 500       ; salva coordenadas em xtc
nstlog                  = 500       ; update log
compressed-x-grps       = System

; NEIGHBORSEARCHING
cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
rlist                   = 1.0       ; Cut-off for making neighbor list 

; ELETROSTATICA
coulombtype             = PME
rcoulomb                = 1.0       ; short-range electrostatic cutoff (in nm)
pme-order               = 4
fourierspacing          = 0.12

; VDW
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
rvdw                    = 1.0       ; short-range van der Waals cutoff (in nm)
DispCorr                = EnerPres

; MOVIMENTO DO CENTRO DE MASSA
comm-mode               = Linear
nstcomm                 = 100

; ACOPLAMENTO DE TEMPERATURA
tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 1.0         ; time constant, in ps
ref-t                   = 298.15      ; temperatura de ref.

; PRESSAO
pcoupl                  = no

; GERACAO DE VELOCIDADES
gen-vel                 = no
ld-seed                 = 777103
continuation            = yes

; LIGACOES
constraint-algorithm    = lincs
constraints             = h-bonds
lincs-iter              = 1
lincs-order             = 4
