Bootstrap: docker
From: nvidia/cuda:12.9.1-devel-ubuntu24.04

%post
    set -eu
    export DEBIAN_FRONTEND=noninteractive

    GMX=2026.4
    NJOBS=32
    SRC=/opt/src

    # Sem o repo da NVIDIA, o upgrade so toca no Ubuntu: CUDA fica em 12.9.1.
    rm -f /etc/apt/sources.list.d/cuda*
    apt-get update
    apt-get upgrade -y
    apt-get install -y --no-install-recommends \
        build-essential cmake wget ca-certificates libhwloc-dev libhdf5-dev

    mkdir -p ${SRC} && cd ${SRC}
    wget -qO- https://ftp.gromacs.org/gromacs/gromacs-${GMX}.tar.gz | tar xz

    cmake -S gromacs-${GMX} -B build \
        -DGMX_BUILD_OWN_FFTW=ON \
        -DGMX_SIMD=AVX2_256 \
        -DGMX_GPU=CUDA \
        -DCUDAToolkit_ROOT=/usr/local/cuda \
        -DCMAKE_CUDA_ARCHITECTURES=89 \
        -DGMX_HWLOC=ON \
        -DGMX_USE_HDF5=ON
    cmake --build build --target install -j ${NJOBS}

    cd / && rm -rf ${SRC} /var/lib/apt/lists/*

%environment
    export PATH=/usr/local/gromacs/bin:$PATH

%test
    V=$(/usr/local/gromacs/bin/gmx --version)
    echo "$V" | grep -E "GROMACS version|GPU support|SIMD instructions"
    echo "$V" | grep -q "GPU support: *CUDA" \
        || { echo "FALHA: build sem suporte a CUDA"; exit 1; }
    echo "$V" | grep -q "SIMD instructions: *AVX2_256" \
        || { echo "FALHA: SIMD nao e AVX2_256 (autodeteccao pegou o no de build)"; exit 1; }

%runscript
    exec "$@"

%labels
    Author  "Patrick Allan dos Santos Faustino"
    Version "2026.4-gridunesp"
    Stack   "Ubuntu 24.04 | CUDA 12.9.1 (sm_89) | GROMACS 2026.4 thread-MPI"
