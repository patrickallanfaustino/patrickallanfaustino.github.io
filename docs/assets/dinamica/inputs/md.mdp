; =====================================================================
; PRODUCAO - sem restricoes posicionais
; =====================================================================

; RUN CONTROL PARAMETERS
integrator              = md        ; leap-frog integrator
nsteps                  = 150000000 ; 300 ns
dt                      = 0.002
comm-mode               = Linear
nstcomm                 = 100

; LANGEVIN DYNAMICS OPTIONS
ld-seed                 = 5510108

; OUTPUT CONTROL OPTIONS
nstxout			= 0	    ; salva coordenadas em trr
nstvout                 = 0         ; salva velocidades em trr
nstfout			= 0	    ; salva forcas em trr
nstenergy               = 5000      ; salva energias em edr
nstxout-compressed      = 5000      ; salva coordenadas em xtc
nstlog                  = 5000      ; update log
compressed-x-grps       = System

; NEIGHBORSEARCHING PARAMETERS
cutoff-scheme           = Verlet
nstlist                 = 20
pbc                     = xyz
rlist                   = 1.0       ; Cut-off for making neighbor list 

; OPTIONS FOR ELECTROSTATICS AND VDW
coulombtype             = PME
coulomb-modifier        = Potential-shift-Verlet
rcoulomb                = 1.0       ; short-range electrostatic cutoff (in nm)
vdwtype                 = Cut-off
vdw-modifier            = Potential-shift
rvdw                    = 1.0       ; short-range van der Waals cutoff (in nm)
DispCorr                = EnerPres
pme-order               = 4
fourierspacing          = 0.12

; OPTIONS FOR WEAK COUPLING ALGORITHMS
; temperature coupling  
tcoupl                  = V-rescale
tc-grps                 = System
tau-t                   = 1.0         ; time constant, in ps
ref-t                   = 298.15      ; temperatura de ref, em K

; pressure coupling  
pcoupl                  = C-rescale
pcoupltype              = isotropic       ; uniform scaling of box vectors
tau-p                   = 3.0             ; time constant, in ps
ref-p                   = 1.0             ; pressao de ref, em bar
compressibility         = 4.5e-5

; GENERATE VELOCITIES FOR STARTUP RUN
gen-vel                 = no

; OPTIONS FOR BONDS 
continuation            = yes
constraint-algorithm    = lincs
constraints             = h-bonds
lincs-iter              = 1
lincs-order             = 4

